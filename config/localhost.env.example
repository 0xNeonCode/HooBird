# Diese Datei authentifiziert nirgends.
# scripts/init_local_env.py schreibt runtime/localhost.env mit zufälligen
# Werten, wenn die Datei noch fehlt. Die erzeugte Datei ist gitignored und
# gilt nur für den Compose-Stack auf 127.0.0.1, der mit ihr gestartet wird.
# Die Platzhalter unten sind keine gültigen Zugangsdaten.

REGISTRATION_SHARED_SECRET=replace-with-a-localhost-only-value
MACAROON_SECRET_KEY=replace-with-a-localhost-only-value
FORM_SECRET=replace-with-a-localhost-only-value
ADMIN_LOCALPART=hoobirdadmin
ADMIN_USERNAME=hoobird-admin
ADMIN_PASSWORD=replace-with-a-localhost-only-value
POSTGRES_PASSWORD=replace-with-a-localhost-only-value
SYNAPSE_DB_PASSWORD=replace-with-a-localhost-only-value
POLICY_DB_PASSWORD=replace-with-a-localhost-only-value
POLICY_DSN=postgresql://hoobird_policy:replace-with-a-localhost-only-value@127.0.0.1:15432/hoobird_policy
HOOBIRD_DEV_RETURN_EMAIL_TOKENS=1
