version: 1
formatters:
  precise:
    format: "%(asctime)s %(name)s %(levelname)s %(message)s"
handlers:
  console:
    class: logging.StreamHandler
    formatter: precise
loggers:
  hoobird_policy:
    level: INFO
  synapse.storage.databases.main.event_federation:
    level: WARNING
root:
  level: INFO
  handlers: [console]
disable_existing_loggers: false
